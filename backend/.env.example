PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/timecapsule?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Gmail SMTP: use a Google App Password, NOT your normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=yourgmail@gmail.com
MAIL_PASS=your_16_character_google_app_password
MAIL_FROM="TimeCapsule <yourgmail@gmail.com>"
